# Positron environment example — pre-release / active development
#
# DEMO SAFE DEFAULT:
# Keep all adapters fake, keep push/merge disabled, and keep the merge
# kill switch enabled. The one-command Docker demo generates its own local
# ignored credentials; no GitHub token is needed.
#
# ADVANCED REAL MODE:
# Set the adapter modes to real only after configuring the required binaries,
# repository values, credentials, and safety approvals described in docs/install/advanced.md.

# ── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Adapter modes (fake | real) ────────────────────────
POSITRON_GITHUB_MODE=fake
POSITRON_SPECKIT_MODE=fake
POSITRON_OPENCODE_MODE=fake

# ── Safety gates ───────────────────────────────────────
POSITRON_ENABLE_REAL_SPECKIT=false
POSITRON_ENABLE_DOGFOOD_FIXTURE_CHANGE=false
POSITRON_ENABLE_PUSH=false
POSITRON_ENABLE_MERGE=false
POSITRON_MERGE_DRY_RUN=true
POSITRON_MERGE_KILL_SWITCH=true
POSITRON_ENABLE_FIX_LOOP=false
# POSITRON_MAX_FIX_LOOPS=3

# ── GitHub (required only for POSITRON_GITHUB_MODE=real) ─
GITHUB_TOKEN=
POSITRON_REPO_OWNER=your_github_username
POSITRON_REPO_NAME=your_repo_name
POSITRON_REPO_DEFAULT_BRANCH=main

# ── Local state ────────────────────────────────────────
POSITRON_DB_PATH=.positron/runs/positron.db
# POSITRON_REDIS_URL=redis://localhost:6379

# ── Admin / integrations ──────────────────────────────
# POSITRON_ADMIN_TOKEN=generate-a-local-token
# POSITRON_WEBHOOK_URL=
# POSITRON_RESEARCH_API_KEY=
# POSITRON_CORS_ORIGIN=http://localhost:5173

# ── Demo and workspace ─────────────────────────────────
POSITRON_DEFAULT_ISSUE_NUMBER=56
# POSITRON_ENABLE_DEMO_LIVE=false
# POSITRON_WORKSPACE_ROOT=/tmp/positron-workspaces

